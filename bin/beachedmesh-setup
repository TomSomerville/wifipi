#!/usr/bin/env python3
"""Set this machine up as a beachedmesh node.

    sudo ./bin/beachedmesh-setup -i wlan1 --name pi4

Generates the node identity, installs the service, and starts it. Safe to
re-run: an existing identity is never replaced, and the service is restarted
rather than duplicated.

    --no-service    identity only, do not touch systemd
    --interval N    announce every N seconds (default 6 hours; use 60 to test)
    --force-keys    replace the identity, changing this node's address
    --no-rename     leave the adapter under its kernel name
"""

import argparse
import os
import shutil
import stat
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from beachedmesh import adapter                      # noqa: E402
from beachedmesh.cli import die, is_root, ok, run, warn  # noqa: E402
from beachedmesh.identity import Identity            # noqa: E402
from beachedmesh.routes import ANNOUNCE_INTERVAL     # noqa: E402

# Absolute, not ~: under sudo, HOME resolves to /root on some distros and the
# invoking user on others, which would silently give a node two identities
# depending on how it was started.
STATE_DIR = "/var/lib/beachedmesh"
DEFAULT_KEY = f"{STATE_DIR}/node.key"
UNIT_PATH = "/etc/systemd/system/beachedmesh.service"

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


# ---------------------------------------------------------- prerequisites --

def check_deps():
    try:
        import cryptography            # noqa: F401
    except ImportError:
        die("python3 cryptography is missing:\n"
            "       pip3 install -r requirements.txt")
    if not shutil.which("iw"):
        die("iw is missing:\n       sudo apt install iw")
    ok("dependencies present")


def check_iface(iface):
    """Warn rather than fail: the adapter may be plugged in later, and the
    service retries on start anyway."""
    if not os.path.exists(f"/sys/class/net/{iface}"):
        warn(f"{iface} does not exist yet -- the service will fail until it does")
        return
    adapter.verify(iface, lambda level, m: (ok if level == "ok" else warn)(m))


# ----------------------------------------------------------------- rename --

# Why rename at all: wlan0/wlan1 are assigned in probe order, so a reboot that
# enumerates the onboard radio second silently swaps them, and the service
# then puts the *onboard* radio in monitor mode and never transmits. A name
# this repo owns cannot be handed to a different device by accident.
IFACE_PREFIX = "BCHD"

# udev makes the name survive a reboot. Without the rule the kernel takes the
# name back on the next boot and the unit points at an interface that no
# longer exists. Numbered 70- to land after the persistent-net rules that ship
# with the distro, so ours is the one that wins.
UDEV_RULES = "/etc/udev/rules.d/70-beachedmesh-net.rules"

RULE_HEADER = ("# beachedmesh: pin adapters to stable names by MAC.\n"
               "# Written by beachedmesh-setup. One line per adapter.\n")


def mac_of(iface):
    try:
        with open(f"/sys/class/net/{iface}/address") as f:
            return f.read().strip().lower()
    except OSError:
        return None


def existing_ifaces():
    try:
        return set(os.listdir("/sys/class/net"))
    except OSError:
        return set()


def read_rules():
    """{mac: name} for the adapters we have already claimed."""
    claimed = {}
    if not os.path.exists(UDEV_RULES):
        return claimed
    with open(UDEV_RULES) as f:
        for line in f:
            if line.lstrip().startswith("#") or "NAME=" not in line:
                continue
            mac = name = None
            for part in line.split(","):
                part = part.strip()
                if part.startswith('ATTR{address}=='):
                    mac = part.split('"')[1].lower()
                elif part.startswith("NAME="):
                    name = part.split('"')[1]
            if mac and name:
                claimed[mac] = name
    return claimed


def allocate_name(mac, claimed):
    """Lowest free BCHDn. Reuses this adapter's own number if it has one.

    "Free" means claimed by no rule *and* held by no interface currently
    present. An unclaimed BCHD0 sitting on the system -- renamed by hand, or
    left by a rules file someone deleted -- would otherwise get a second
    adapter renamed on top of it, and the rename simply fails.
    """
    if mac in claimed:
        return claimed[mac]
    taken = set(claimed.values()) | existing_ifaces()
    n = 0
    while f"{IFACE_PREFIX}{n}" in taken:
        n += 1
    return f"{IFACE_PREFIX}{n}"


def write_rule(mac, new_name):
    claimed = read_rules()
    claimed[mac] = new_name
    with open(UDEV_RULES, "w") as f:
        f.write(RULE_HEADER)
        for m, n in sorted(claimed.items(), key=lambda kv: kv[1]):
            f.write(f'SUBSYSTEM=="net", ACTION=="add", ATTR{{address}}=="{m}", '
                    f'NAME="{n}"\n')
    ok(f"{UDEV_RULES}: {mac} -> {new_name}")
    if shutil.which("udevadm"):
        run("udevadm", "control", "--reload-rules")


def rename_iface(iface, no_rename):
    """Give the adapter a name of ours, now and after every reboot.

    Returns the name the service should use -- the original one if anything
    here could not be done, since a working node under the wrong name beats a
    setup that failed.
    """
    if no_rename:
        return iface
    if iface.startswith(IFACE_PREFIX):
        ok(f"{iface} already named by beachedmesh")
        return iface
    if not os.path.exists(f"/sys/class/net/{iface}"):
        warn(f"{iface} is not present -- cannot rename it yet")
        return iface

    mac = mac_of(iface)
    if not mac:
        warn(f"cannot read the MAC of {iface} -- leaving its name alone")
        return iface
    if not shutil.which("ip"):
        warn("ip is missing -- leaving the adapter name alone")
        return iface

    new_name = allocate_name(mac, read_rules())

    # The kernel refuses to rename an interface that is up.
    run("ip", "link", "set", iface, "down")
    r = run("ip", "link", "set", iface, "name", new_name)
    if r.returncode != 0:
        run("ip", "link", "set", iface, "up")
        warn(f"could not rename {iface}: {(r.stderr or r.stdout).strip()}")
        return iface
    run("ip", "link", "set", new_name, "up")
    ok(f"renamed {iface} -> {new_name}")

    # The rule is written after the live rename succeeds, so a failed rename
    # does not leave a rule promising a name nothing will ever have.
    write_rule(mac, new_name)
    return new_name


# --------------------------------------------------------------- identity --

def setup_identity(path, force):
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)

    if os.path.exists(path) and not force:
        ident = Identity.load(path)
        ok(f"identity {ident.node_id.hex()} (existing, unchanged)")
        return ident

    if force and os.path.exists(path):
        warn(f"replacing identity {Identity.load(path).node_id.hex()} -- "
             f"this node's address changes and peers must relearn it")

    ident = Identity.generate()
    ident.save(path)
    mode = stat.S_IMODE(os.stat(path).st_mode)
    ok(f"identity {ident.node_id.hex()} (generated)")
    if mode & 0o077:
        warn(f"{path} is mode {mode:04o} -- the private key is readable "
             f"by others")
    return ident


# ---------------------------------------------------------------- service --

UNIT = """\
[Unit]
Description=beachedmesh node
After=network.target

# No start rate limit. systemd's default gives up permanently after 5 rapid
# failures, which is exactly wrong for an unattended node: a solar site that
# drained its battery and came back days later would find the service dead
# with nobody present to restart it. The daemon waits for its adapter rather
# than exiting, so repeated starts should not happen -- but if they do, giving
# up is never the right answer here.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart={exec_start}
WorkingDirectory={repo}

# Raw sockets and iw need root: NET_RAW to inject, NET_ADMIN to set monitor
# mode. No further sandboxing, since those are the whole job.
User=root

# SIGTERM is handled: the loop exits, buffered route writes are flushed, and
# sqlite closes. Give it room rather than killing it mid-write.
KillSignal=SIGTERM
TimeoutStopSec=15

Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal

[Install]
# multi-user.target is reached during boot, before and independent of any
# login. Nothing here depends on a session.
WantedBy=multi-user.target
"""


def have_systemd():
    return os.path.isdir("/run/systemd/system") and shutil.which("systemctl")


def install_service(iface, name, interval):
    if not have_systemd():
        warn("no systemd here -- run the service by hand:\n"
             f"       sudo {REPO}/bin/beachedmesh -i {iface}")
        return False

    # Point at the repo in place rather than copying to /opt: a git pull then
    # updates the running service, which is what you want while the protocol
    # is still moving.
    cmd = [f"{REPO}/bin/beachedmesh", "-i", iface]
    if name:
        cmd += ["--name", name]
    if interval != ANNOUNCE_INTERVAL:
        cmd += ["--announce-interval", str(int(interval))]

    with open(UNIT_PATH, "w") as f:
        f.write(UNIT.format(exec_start=" ".join(cmd), repo=REPO))
    ok(f"wrote {UNIT_PATH}")

    run("systemctl", "daemon-reload")
    r = run("systemctl", "enable", "beachedmesh")
    if r.returncode != 0:
        die(f"systemctl enable failed: {r.stderr.strip()}")
    ok("enabled at boot")

    # restart, not start: re-running setup should pick up new arguments.
    r = run("systemctl", "restart", "beachedmesh")
    if r.returncode != 0:
        die(f"systemctl restart failed: {r.stderr.strip()}")
    ok("service started")
    return True


def main():
    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    p.add_argument("-i", "--iface", help="USB wifi adapter, e.g. wlan1")
    p.add_argument("--name", default="", help="advertise this name")
    p.add_argument("--key", default=DEFAULT_KEY)
    p.add_argument("--interval", type=float, default=ANNOUNCE_INTERVAL,
                   help="announce every N seconds (60 while testing)")
    p.add_argument("--no-service", action="store_true",
                   help="identity only, do not touch systemd")
    p.add_argument("--force-keys", action="store_true",
                   help="replace the identity, changing this node's address")
    p.add_argument("--no-rename", action="store_true",
                   help="leave the adapter under its kernel name")
    args = p.parse_args()

    if not is_root():
        die(f"must run as root to write {STATE_DIR} and install the service")
    if not args.no_service and not args.iface:
        die("-i <interface> is required to install the service "
            "(or pass --no-service for identity only)")

    check_deps()
    if args.iface:
        check_iface(args.iface)

    ident = setup_identity(args.key, args.force_keys)

    if args.no_service:
        print(f"\nidentity only. To run:\n"
              f"  sudo {REPO}/bin/beachedmesh -i <iface>")
        return 0

    iface = rename_iface(args.iface, args.no_rename)
    started = install_service(iface, args.name, args.interval)

    print()
    ok(f"node {ident.node_id.hex()}" + (f" ({args.name})" if args.name else ""))
    print(f"\n  announcing every {args.interval/60:.0f} min on {iface}")
    if started:
        print(f"\n  logs     journalctl -u beachedmesh -f")
        print(f"  routes   {REPO}/bin/beachedmesh-routes")
        print(f"  stop     sudo systemctl stop beachedmesh")
    return 0


if __name__ == "__main__":
    sys.exit(main())
