#!/usr/bin/env python3
"""Verify an adapter, then monitor beachedmesh traffic.

    sudo ./bin/beachedmesh-monitor -i wlan1

Four checks, each failing loudly with the reason:

    1. the interface is a USB wifi adapter, not the onboard SDIO radio
    2. its driver advertises monitor mode
    3. monitor mode actually engages on our channel
    4. the driver accepts injected frames

Then it stays in monitor mode and prints only our mesh traffic: frames whose
802.11 BSSID is BEACHD and whose packet magic is BCHD. Everything else in the
air is discarded.
"""

import argparse
import os
import struct
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from beachedmesh import adapter                                       # noqa: E402
from beachedmesh.cli import (DIM, GRN, RST, YEL, die, is_root,        # noqa: E402
                             mac_str, ok, say, warn)
from beachedmesh.frame import (BadFrame, DEFAULT_HOP_LIMIT, HEADER_LEN,  # noqa: E402
                               Packet, TYPE_ANNOUNCE, _TYPE_NAMES)
from beachedmesh.identity import (ANNOUNCE_MIN, BadAnnounce,          # noqa: E402
                                  Identity, parse_announce)
from beachedmesh.link import BSSID, MonitorLink                       # noqa: E402
from beachedmesh.routes import RouteTable                             # noqa: E402


def verify_injection(link, count=5):
    """The driver accepts injected frames.

    Acceptance, not radiation: a half-duplex radio cannot hear its own
    transmission. Another node receiving an announce is the real proof.
    """
    probe = Packet(src=b"\x00" * 16, payload=b"beachedmesh-probe")
    for i in range(count):
        try:
            link.send(probe.to_bytes())
        except OSError as e:
            die(f"driver rejected injected frame {i}: {e}")
        time.sleep(0.02)
    ok(f"driver accepted {count}/{count} injected frames")
    print(f"{DIM}       acceptance, not radiation -- another node hearing an "
          f"announce is the real proof{RST}")


# --------------------------------------------------------------- monitor --

def hexdump(data, indent="    "):
    out = []
    for off in range(0, len(data), 16):
        chunk = data[off:off + 16]
        hexes = " ".join(f"{b:02x}" for b in chunk)
        text = "".join(chr(b) if 32 <= b < 127 else "." for b in chunk)
        out.append(f"{indent}{off:04x}  {hexes:<47}  |{text}|")
    return "\n".join(out)


def _section(title, size, note=""):
    tail = f"  {note}" if note else ""
    return f"{DIM}--- {title} ({size} bytes){tail} ---{RST}"


def print_frame(pkt, data, meta):
    """The whole frame, split the way it sits on the wire.

    The frame header belongs to 802.11 and is rebuilt at every hop; the
    packet header and body are ours and travel end to end unchanged. The FCS
    is not shown -- mt7925u strips it before we see the frame, having already
    checked it in hardware.
    """
    dot11 = meta.get("dot11", b"")
    header, body = data[:HEADER_LEN], data[HEADER_LEN:]

    # ---- frame header (802.11) ----
    print(_section("FRAME HEADER  802.11 MAC", len(dot11), "rebuilt every hop"))
    if len(dot11) == 24:
        fc_type, fc_flags, dur, a1, a2, a3, seq = struct.unpack("<BBH6s6s6sH", dot11)
        print(f"      frame control  0x{fc_type:02x} 0x{fc_flags:02x}"
              f"   (type/subtype, flags)")
        print(f"      duration       {dur}")
        print(f"      addr1 receiver {mac_str(a1)}")
        print(f"      addr2 sender   {mac_str(a2)}")
        print(f"      addr3 bssid    {mac_str(a3)}  ({a3.decode(errors='replace')})")
        print(f"      sequence       {seq >> 4}   fragment {seq & 0x0f}")
    print(hexdump(dot11, "      "))

    # ---- packet header (ours) ----
    print(_section("PACKET HEADER  beachedmesh", len(header), "end to end"))
    print(f"      magic          {header[0:4].decode(errors='replace')}")
    print(f"      version        {header[4]}")
    print(f"      type           0x{pkt.type:02x}  "
          f"{_TYPE_NAMES.get(pkt.type, 'unknown')}")
    print(f"      flags          0x{pkt.flags:02x}  {pkt.flags:08b}")
    print(f"      hop_limit      {pkt.hop_limit}")
    print(f"      packet_id      {pkt.packet_id.hex()}")
    print(f"      src            {pkt.src.hex()}")
    print(f"      dst            {pkt.dst.hex()}"
          f"{'  (broadcast)' if pkt.is_broadcast else ''}")
    print(hexdump(header, "      "))

    # ---- packet body ----
    print(_section("PACKET BODY", len(body)))
    if pkt.type == TYPE_ANNOUNCE and len(body) >= ANNOUNCE_MIN:
        print(f"      ed25519 pub    {body[0:32].hex()}")
        print(f"      x25519 pub     {body[32:64].hex()}")
        print(f"      random         {body[64:74].hex()}")
        print(f"      signature      {body[74:138].hex()}")
        if len(body) > ANNOUNCE_MIN:
            print(f"      app data       {body[ANNOUNCE_MIN:]!r}")
    print(hexdump(body, "      "))

    print()

def monitor(link, brief, own_id=None):
    print(f"\nmonitoring -- BSSID {mac_str(BSSID)} ({BSSID.decode()}), "
          f"magic BCHD   (ctrl-c to stop)\n")
    seen = {}
    routes = RouteTable(own_id=own_id)
    warmed = routes.warm()
    if warmed:
        print(f"warmed {warmed:,} routes from disk")
    last_expire = time.time()
    try:
        while True:
            got = link.recv()

            # Drop nodes we have stopped hearing from. Doing it on a timer
            # rather than on receive means a silent mesh still ages out.
            routes.tick()          # flush buffered writes when due

            if time.time() - last_expire > 30:
                for dead in routes.expire():
                    print(f"[{time.strftime('%H:%M:%S')}] {YEL}EXPIRED{RST} "
                          f"{dead.hex()} -- no announce in {routes.ttl:.0f}s")
                last_expire = time.time()

            if got is None:
                continue
            data, meta = got
            try:
                pkt = Packet.from_bytes(data)   # this checks the BCHD magic
            except BadFrame:
                continue

            ts = time.strftime("%H:%M:%S")
            rssi = meta.get("rssi")
            sig = f"{rssi:>4} dBm" if rssi is not None else "   ? dBm"
            rate = meta.get("rate_mbps")
            rate_s = f"{rate:>5.1f} Mbps" if rate else "    ? Mbps"
            kind = _TYPE_NAMES.get(pkt.type, f"0x{pkt.type:02x}")
            # Clamped: a sender using a different initial hop_limit would
            # otherwise produce a negative count.
            hops = max(0, DEFAULT_HOP_LIMIT - pkt.hop_limit)

            if pkt.type != TYPE_ANNOUNCE:
                print(f"[{ts}] {kind:<8} {pkt.src.hex()}  {sig} {rate_s}  "
                      f"hops={hops}  {len(pkt.payload)}B")
            else:
                try:
                    info = parse_announce(pkt.src, pkt.payload)
                except BadAnnounce as e:
                    print(f"[{ts}] {YEL}ANNOUNCE rejected{RST} from "
                          f"{pkt.src.hex()}: {e}")
                    continue
                seen[pkt.src] = time.time()
                name = info["app_data"].decode(errors="replace")
                # addr2 is the radio that handed us this frame, so it is the
                # next hop toward whoever originated the announce.
                what = routes.learn(
                    pkt.src, meta["src_mac"], hops, rssi,
                    sign_pub=info["sign_pub"], encrypt_pub=info["encrypt_pub"],
                    name=name)
                tag = {"new": f"{GRN}NEW{RST}", "better": f"{GRN}BETTER{RST}",
                       "settling": f"{YEL}SETTLING{RST}",
                       "self": f"{DIM}SELF{RST}"}.get(what, "      ")
                print(f"[{ts}] ANNOUNCE {tag:<6} {info['node_id'].hex()}  "
                      f"{sig} {rate_s}  hops={hops}  name={name or '-'}")
                print(f"{DIM}         verified: node_id matches its key, "
                      f"signature valid   route: {what}{RST}")
                if what in ("new", "better"):
                    print()
                    print(f"{DIM}=== ROUTE TABLE ==={RST}")
                    print(routes.render())
                    print(f"{DIM}         {routes.summary()}{RST}")
                    print()

            if not brief:
                print_frame(pkt, data, meta)
            sys.stdout.flush()
    except KeyboardInterrupt:
        pass
    print(f"\nheard {len(seen)} node(s)")


def main():
    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    p.add_argument("-i", "--iface", required=True,
                   help="monitor-mode interface, e.g. wlan1")
    p.add_argument("--key", default="/var/lib/beachedmesh/node.key",
                   help="identity file, used only to recognise our own "
                        "announces relayed back to us")
    p.add_argument("--brief", action="store_true",
                   help="one line per packet instead of the full frame")
    p.add_argument("--no-verify", action="store_true",
                   help="skip the checks and go straight to monitoring")
    args = p.parse_args()

    if not is_root():
        print("must run as root (raw sockets, iw)", file=sys.stderr)
        return 1

    if not args.no_verify:
        if not adapter.verify_and_configure(args.iface, say):
            return 1

    try:
        link = MonitorLink(args.iface)
    except OSError as e:
        die(f"cannot open {args.iface}: {e}")

    if not args.no_verify:
        verify_injection(link)

    # Knowing our own id lets the route table ignore our announces when a
    # neighbour relays them back. Not required to monitor, so a missing key
    # is only worth a note.
    own_id = None
    if os.path.exists(args.key):
        own_id = Identity.load(args.key).node_id
        print(f"this node: {own_id.hex()}")
    else:
        warn(f"no identity at {args.key} -- cannot filter our own announces")

    monitor(link, args.brief, own_id)
    link.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
