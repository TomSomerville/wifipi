#!/usr/bin/env python3
"""Show what this node knows about reaching others.

    ./bin/beachedmesh-routes                 recent routes
    ./bin/beachedmesh-routes --neighbours    direct only
    ./bin/beachedmesh-routes --node a1b2...  everything about one node
    ./bin/beachedmesh-routes --stats         table sizes and age spread
    ./bin/beachedmesh-routes --live          the running daemon's hot table
    ./bin/beachedmesh-routes --flood         relay counters and pending relays

Two sources, showing different things. The database is everything ever
learned, and is readable whether or not the service runs. --live asks the
daemon itself, which is the only way to see the hot table's actual contents,
the LRU cap in effect, and flooder state that never touches disk.
"""

import argparse
import os
import sqlite3
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from beachedmesh.control import DEFAULT_SOCKET, query   # noqa: E402
from beachedmesh.routes import DEFAULT_DB               # noqa: E402

DIM, RST = "\033[2m", "\033[0m"


def age_str(seconds):
    if seconds < 90:
        return f"{seconds:.0f}s"
    if seconds < 5400:
        return f"{seconds / 60:.0f}m"
    if seconds < 172800:
        return f"{seconds / 3600:.0f}h"
    return f"{seconds / 86400:.1f}d"


def mac(b):
    return ":".join(f"{x:02x}" for x in b) if b else "?"


def connect(path):
    if not os.path.exists(path):
        print(f"no route database at {path}\n"
              f"  the service creates it on first run: "
              f"sudo ./bin/beachedmesh -i wlan1", file=sys.stderr)
        sys.exit(1)
    # Read-only: this must never be the thing that corrupts a live table.
    return sqlite3.connect(f"file:{path}?mode=ro", uri=True)


def show_routes(db, limit, neighbours_only, name_filter):
    where, params = [], []
    if neighbours_only:
        where.append("hops = 0")
    if name_filter:
        where.append("name LIKE ?")
        params.append(f"%{name_filter}%")
    clause = ("WHERE " + " AND ".join(where)) if where else ""
    params.append(limit)

    rows = db.execute(f"""
        SELECT node_id, next_hop, hops, rssi, last_seen, announces, name
        FROM routes {clause}
        ORDER BY hops ASC, last_seen DESC LIMIT ?""", params).fetchall()

    if not rows:
        print("no routes yet -- has the service heard an announce?")
        return

    now = time.time()
    print(f"  {'node':<34} {'via':<19} {'hops':>6} {'rssi':>5} "
          f"{'age':>6} {'seen':>5}  name")
    print(f"  {'-'*34} {'-'*19} {'-'*6} {'-'*5} {'-'*6} {'-'*5}  {'-'*10}")
    for nid, nh, hops, rssi, last, ann, nm in rows:
        hop_s = "direct" if hops == 0 else str(hops)
        print(f"  {nid.hex():<34} {mac(nh):<19} {hop_s:>6} "
              f"{(rssi if rssi is not None else '?'):>5} "
              f"{age_str(now - last):>6} {ann:>5}  {nm or ''}")


def show_node(db, prefix):
    rows = db.execute("""
        SELECT node_id, next_hop, hops, rssi, first_seen, last_seen,
               announces, sign_pub, encrypt_pub, name
        FROM routes WHERE hex(node_id) LIKE ?""",
        (prefix.upper() + "%",)).fetchall()
    if not rows:
        print(f"no node matching {prefix}")
        return
    now = time.time()
    for (nid, nh, hops, rssi, first, last, ann, sp, ep, nm) in rows:
        print(f"node        {nid.hex()}")
        print(f"  name      {nm or '-'}")
        print(f"  next hop  {mac(nh)}")
        print(f"  distance  {'direct' if hops == 0 else str(hops) + ' hops'}")
        print(f"  signal    {rssi if rssi is not None else '?'} dBm")
        print(f"  announces {ann}")
        print(f"  first     {age_str(now - first)} ago")
        print(f"  last      {age_str(now - last)} ago")
        print(f"  sign key  {sp.hex() if sp else '(not stored)'}")
        print(f"  encr key  {ep.hex() if ep else '(not stored)'}")
        print()


def show_stats(db, path):
    total = db.execute("SELECT COUNT(*) FROM routes").fetchone()[0]
    if not total:
        print("route table is empty")
        return
    direct = db.execute("SELECT COUNT(*) FROM routes WHERE hops=0").fetchone()[0]
    size = os.path.getsize(path)
    print(f"routes      {total:,}  ({direct:,} direct neighbours)")
    print(f"database    {size/1e6:.1f} MB  ({size/total:.0f} B/row)")

    print("\nby distance")
    for hops, n in db.execute(
            "SELECT hops, COUNT(*) FROM routes GROUP BY hops ORDER BY hops"):
        label = "direct" if hops == 0 else f"{hops} hop" + ("s" if hops > 1 else "")
        print(f"  {label:<10} {n:>8,}")

    now = time.time()
    print("\nby age")
    buckets = [(300, "< 5 min"), (3600, "< 1 hour"), (86400, "< 1 day"),
               (604800, "< 1 week"), (float("inf"), "older")]
    prev = 0
    for cutoff, label in buckets:
        n = db.execute("SELECT COUNT(*) FROM routes WHERE ? - last_seen >= ? "
                       "AND ? - last_seen < ?",
                       (now, prev, now, cutoff)).fetchone()[0]
        if n:
            print(f"  {label:<10} {n:>8,}")
        prev = cutoff

    row = db.execute("SELECT name, announces FROM routes "
                     "ORDER BY announces DESC LIMIT 1").fetchone()
    if row and row[1] > 1:
        print(f"\nmost heard  {row[0] or '(unnamed)'} -- {row[1]:,} announces")


def show_live(sock, limit, neighbours_only):
    try:
        r = query("routes", path=sock, limit=limit, neighbours=neighbours_only)
    except ConnectionError as e:
        print(f"{e}", file=sys.stderr)
        print("  is the service running?  systemctl status beachedmesh",
              file=sys.stderr)
        return 1
    st = query("status", path=sock)
    print(f"node {st['node_id']}"
          + (f" ({st['name']})" if st.get("name") else "")
          + f"  up {st['uptime']/3600:.1f}h  on {st['iface']}")
    print(f"hot {r['hot']:,}/{r['max_hot']:,} "
          f"({r['memory_bytes']/1e6:.1f} MB)   "
          f"rx {st['received']:,} tx {st['sent']:,}  "
          f"relayed {st['relayed']:,} cancelled {st['cancelled']:,}")
    print(f"next announce in {st['next_announce']/60:.1f} min")
    print()

    if not r["routes"]:
        print("  (hot table is empty)")
        return 0
    print(f"  {'node':<34} {'via':<19} {'hops':>6} {'rssi':>5} {'age':>6}")
    print(f"  {'-'*34} {'-'*19} {'-'*6} {'-'*5} {'-'*6}")
    for e in r["routes"]:
        hop_s = "direct" if e["hops"] == 0 else str(e["hops"])
        via = ":".join(e["next_hop"][i:i+2] for i in range(0, 12, 2))
        print(f"  {e['node_id']:<34} {via:<19} {hop_s:>6} "
              f"{(e['rssi'] if e['rssi'] is not None else '?'):>5} "
              f"{age_str(e['age']):>6}")
    if r["truncated"]:
        print(f"  {DIM}... {r['hot'] - len(r['routes']):,} more not shown{RST}")
    return 0


def show_flood(sock):
    try:
        f = query("flood", path=sock)
    except ConnectionError as e:
        print(f"{e}", file=sys.stderr)
        return 1
    print(f"relayed    {f['relayed']:,}")
    print(f"cancelled  {f['cancelled']:,}   "
          f"{DIM}(another node relayed first){RST}")
    print(f"duplicates {f['duplicates']:,}   "
          f"{DIM}(already seen, dropped){RST}")
    print(f"hop-expired {f['expired_hops']:,}  "
          f"{DIM}(arrived with no hops left){RST}")
    print(f"seen cache {f['seen_cache']:,}/{f['seen_capacity']:,}")
    print(f"threshold  {f['threshold']}  "
          f"{DIM}(relays heard before cancelling ours){RST}")
    if f["pending_detail"]:
        print()
        print(f"pending relays ({f['pending']}):")
        for p in f["pending_detail"]:
            print(f"  {p['src'][:16]}  id={p['packet_id']}  "
                  f"hops_left={p['hops_left']}  heard={p['heard']}  "
                  f"fires in {p['in_ms']:.0f} ms")
    else:
        print()
        print("pending relays: none")
    return 0


def main():
    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    p.add_argument("--db", default=DEFAULT_DB)
    p.add_argument("-n", "--limit", type=int, default=40)
    p.add_argument("--neighbours", action="store_true",
                   help="only nodes heard directly")
    p.add_argument("--name", help="filter by advertised name")
    p.add_argument("--node", help="full detail for one node (hex prefix)")
    p.add_argument("--stats", action="store_true")
    p.add_argument("--live", action="store_true",
                   help="ask the running daemon for its in-memory table")
    p.add_argument("--flood", action="store_true",
                   help="relay counters and pending relays from the daemon")
    p.add_argument("--socket", default=DEFAULT_SOCKET)
    args = p.parse_args()

    if args.live:
        return show_live(args.socket, args.limit, args.neighbours)
    if args.flood:
        return show_flood(args.socket)

    db = connect(args.db)
    if args.node:
        show_node(db, args.node)
    elif args.stats:
        show_stats(db, args.db)
    else:
        show_routes(db, args.limit, args.neighbours, args.name)
    db.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
