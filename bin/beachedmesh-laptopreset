#!/usr/bin/env python3
"""Recover an adapter that transmits but hears nothing.

    sudo ./bin/beachedmesh-laptopreset             diagnose, then reload
    sudo ./bin/beachedmesh-laptopreset --check     diagnose only, change nothing
    sudo ./bin/beachedmesh-laptopreset -i wlan2    a different interface

The fault this exists for: the node keeps announcing and peers hear it, but it
receives nothing at all -- not even ambient beacons from access points that are
plainly in range. Seen on a Pi and a laptop after moving the adapter between
USB ports.

A reboot does not fix it. The USB port stays powered across a warm reboot, so
the adapter comes back in the state it went down in. Reloading the mt76 module
stack does, because that tears the device down in software.

The diagnosis is unobvious because every beachedmesh-level check passes:
monitor mode is set, injection is accepted, the service is healthy. Only an
unfiltered capture seeing zero frames shows the receive path is dead below
anything in this repo -- which is why this listens before and after rather than
trusting the service to report its own health.
"""

import argparse
import os
import shutil
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from beachedmesh import recover                    # noqa: E402
from beachedmesh.adapter import iface_info         # noqa: E402
from beachedmesh.cli import (DIM, RST, err, is_root, note, ok,  # noqa: E402
                             run, say, skip, warn)

# The listening and the driver reload are shared with the service, which does
# the same check on startup -- one definition of "deaf" for both, so a node
# that recovers itself and a node recovered by hand behave identically.
SNIFF_SECONDS = recover.LISTEN_SECONDS

# The service sets monitor mode and channel itself on start; verifying before
# it has done that would fail for the wrong reason.
SERVICE_SETTLE = 3.0

UNIT_PATH = "/etc/systemd/system/beachedmesh.service"


def sniff(iface, seconds):
    """Count frames of any kind. This is the whole diagnosis."""
    frames = recover.frames_heard(iface, seconds)
    if frames is None:
        err(f"cannot listen on {iface}")
    return frames


def service_installed():
    return bool(shutil.which("systemctl")) and os.path.exists(UNIT_PATH)


def reload_driver():
    """Unload the whole stack, then load the top of it back."""
    if not recover.reload_driver(say):
        note("if a module is still in use, stop NetworkManager or "
             "wpa_supplicant and run this again")
        return False
    return True


def unplug_advice():
    note("unplug the adapter for ten seconds and plug it back in -- that is "
         "the only full power cycle left, and a reboot is not one")


def main():
    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    p.add_argument("-i", "--iface", default="wlan1",
                   help="interface to reset (default wlan1)")
    p.add_argument("--check", action="store_true",
                   help="diagnose only, do not touch the driver")
    p.add_argument("--seconds", type=float, default=SNIFF_SECONDS,
                   help=f"how long to listen (default {SNIFF_SECONDS:g})")
    args = p.parse_args()
    iface = args.iface

    if not is_root():
        print("must run as root", file=sys.stderr)
        return 1
    if not shutil.which("modprobe") or not shutil.which("iw"):
        err("needs modprobe and iw")
        return 1

    # ---- diagnose ----
    if not os.path.exists(f"/sys/class/net/{iface}"):
        err(f"{iface} does not exist -- the adapter is not enumerated at all")
        note("check lsusb and dmesg; reloading will not conjure it back")
        return 1

    itype, chan = iface_info(iface)
    if itype != "monitor":
        warn(f"{iface} is type '{itype}', not monitor")
    elif chan is None:
        # A radio tuned to nothing hears nothing, which looks exactly like the
        # hardware fault and is not one.
        warn(f"{iface} is in monitor mode but tuned to no channel")
    else:
        ok(f"{iface} in monitor mode on channel {chan}")

    print(f"{DIM}listening on {iface} for {args.seconds:g}s...{RST}")
    before = sniff(iface, args.seconds)
    if before is None:
        return 1

    if before > 0:
        ok(f"heard {before:,} frames -- the receive path is alive")
        note("this is not the transmit-works-receive-dead fault. If announces "
             "still are not arriving, the problem is above the radio: check "
             "the channel matches the other nodes, then beachedmesh-routes")
        return 0

    err("heard nothing at all -- the receive path is dead below beachedmesh")
    if args.check:
        skip("--check given, driver left alone")
        return 1

    # ---- reset ----
    had_service = service_installed()
    if had_service:
        run("systemctl", "stop", "beachedmesh")
        ok("service stopped")
    else:
        skip("no service installed")

    if not reload_driver():
        return 1

    if not recover.wait_for_iface(iface):
        err(f"{iface} did not come back within "
            f"{recover.REAPPEAR_TIMEOUT:g}s")
        unplug_advice()
        return 1
    ok(f"{iface} is back")

    if had_service:
        run("systemctl", "start", "beachedmesh")
        time.sleep(SERVICE_SETTLE)
        ok("service started")

    # ---- verify ----
    print(f"{DIM}listening on {iface} for {args.seconds:g}s...{RST}")
    after = sniff(iface, args.seconds)
    if after:
        ok(f"heard {after:,} frames -- receive path restored")
        note("confirm peers come back with: beachedmesh-routes")
        return 0

    err("still hearing nothing after the reload")
    unplug_advice()
    return 1


if __name__ == "__main__":
    sys.exit(main())
