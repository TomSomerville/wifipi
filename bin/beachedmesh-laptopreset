#!/usr/bin/env python3
"""Recover an adapter that transmits but hears nothing.

    sudo ./bin/beachedmesh-laptopreset             diagnose, then reload
    sudo ./bin/beachedmesh-laptopreset --check     diagnose only, change nothing
    sudo ./bin/beachedmesh-laptopreset -i wlan2    a different interface

The fault this exists for: the node keeps announcing and peers hear it, but it
receives nothing at all -- not even ambient beacons from access points that are
plainly in range. Seen on a Pi and a laptop after moving the adapter between
USB ports.

A reboot does not fix it. The USB port stays powered across a warm reboot, so
the adapter comes back in the state it went down in. Reloading the mt76 module
stack does, because that tears the device down in software.

The diagnosis is unobvious because every beachedmesh-level check passes:
monitor mode is set, injection is accepted, the service is healthy. Only an
unfiltered capture seeing zero frames shows the receive path is dead below
anything in this repo -- which is why this listens before and after rather than
trusting the service to report its own health.
"""

import argparse
import os
import select
import shutil
import socket
import subprocess
import sys
import time

# Unload order matters: dependents before dependencies, or modprobe refuses.
MODULES = ["mt7925u", "mt7925_common", "mt792x_lib", "mt76_usb", "mt76"]
LOAD = "mt7925u"

ETH_P_ALL = 0x0003

# Long enough that a quiet 2.4 GHz band still produces beacons -- an access
# point beacons about ten times a second, so anything alive answers at once.
SNIFF_SECONDS = 3.0

# The adapter re-enumerates over USB after the reload, which is not instant.
REAPPEAR_TIMEOUT = 20.0

# The service sets monitor mode and channel itself on start; verifying before
# it has done that would fail for the wrong reason.
SERVICE_SETTLE = 3.0

GRN, RED, YEL, DIM, RST = ("\033[32m", "\033[31m", "\033[33m",
                           "\033[2m", "\033[0m")

UNIT_PATH = "/etc/systemd/system/beachedmesh.service"


def ok(m):
    print(f"{GRN}[ok]{RST}   {m}")


def skip(m):
    print(f"{DIM}[--]   {m}{RST}")


def warn(m):
    print(f"{YEL}[warn]{RST} {m}")


def err(m):
    print(f"{RED}[err]{RST}  {m}")


def note(m):
    print(f"{DIM}       {m}{RST}")


def is_root():
    return getattr(os, "geteuid", lambda: 0)() == 0


def run(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True)


def exists(iface):
    return os.path.exists(f"/sys/class/net/{iface}")


def iface_info(iface):
    """(type, channel) as iw reports them. Either may be None."""
    itype = chan = None
    for line in run("iw", "dev", iface, "info").stdout.splitlines():
        line = line.strip()
        if line.startswith("type "):
            itype = line.split(None, 1)[1]
        elif line.startswith("channel "):
            chan = line.split(None, 1)[1]
    return itype, chan


def sniff(iface, seconds):
    """Count frames of any kind. This is the whole diagnosis.

    Deliberately unfiltered and independent of everything else here: a radio
    whose receive path works sees the world's beacons whether or not a single
    mesh node is switched on. Filtering for our own traffic would confuse a
    dead radio with an empty mesh.
    """
    try:
        s = socket.socket(socket.AF_PACKET, socket.SOCK_RAW,
                          socket.htons(ETH_P_ALL))
        s.bind((iface, ETH_P_ALL))
    except OSError as e:
        err(f"cannot open {iface}: {e}")
        return None

    frames = 0
    deadline = time.monotonic() + seconds
    try:
        while True:
            left = deadline - time.monotonic()
            if left <= 0:
                break
            if not select.select([s], [], [], left)[0]:
                continue
            try:
                if s.recv(4096):
                    frames += 1
            except OSError:
                break
    finally:
        s.close()
    return frames


def service_installed():
    return bool(shutil.which("systemctl")) and os.path.exists(UNIT_PATH)


def reload_driver():
    """Unload the whole stack, then load the top of it back.

    Removing only mt7925u leaves mt76 holding device state, and that state is
    what is broken -- so the dependencies come out too. Loading mt7925u pulls
    them back in by dependency.
    """
    r = run("modprobe", "-r", *MODULES)
    if r.returncode != 0:
        output = r.stderr + r.stdout
        # -r fails as a batch if any one module is busy, so report the reason
        # rather than the exit code: "in use" means something still holds the
        # interface, which is a different fix.
        last = output.strip().splitlines()
        warn("module unload reported: " + (last[-1] if last else "failed"))
        if "in use" in output:
            note("something still holds the radio -- stop NetworkManager or "
                 "wpa_supplicant and run this again")
            return False
    else:
        ok("mt76 stack unloaded")

    # The USB device has to settle before the driver will bind to it again.
    time.sleep(3)

    r = run("modprobe", LOAD)
    if r.returncode != 0:
        err(f"loading {LOAD} failed: {(r.stderr or r.stdout).strip()}")
        return False
    ok(f"{LOAD} loaded")
    return True


def wait_for(iface, timeout=REAPPEAR_TIMEOUT):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if exists(iface):
            return True
        time.sleep(0.5)
    return False


def unplug_advice():
    note("unplug the adapter for ten seconds and plug it back in -- that is "
         "the only full power cycle left, and a reboot is not one")


def main():
    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    p.add_argument("-i", "--iface", default="wlan1",
                   help="interface to reset (default wlan1)")
    p.add_argument("--check", action="store_true",
                   help="diagnose only, do not touch the driver")
    p.add_argument("--seconds", type=float, default=SNIFF_SECONDS,
                   help=f"how long to listen (default {SNIFF_SECONDS:g})")
    args = p.parse_args()
    iface = args.iface

    if not is_root():
        print("must run as root", file=sys.stderr)
        return 1
    if not shutil.which("modprobe") or not shutil.which("iw"):
        err("needs modprobe and iw")
        return 1

    # ---- diagnose ----
    if not exists(iface):
        err(f"{iface} does not exist -- the adapter is not enumerated at all")
        note("check lsusb and dmesg; reloading will not conjure it back")
        return 1

    itype, chan = iface_info(iface)
    if itype != "monitor":
        warn(f"{iface} is type '{itype}', not monitor")
    elif chan is None:
        # A radio tuned to nothing hears nothing, which looks exactly like the
        # hardware fault and is not one.
        warn(f"{iface} is in monitor mode but tuned to no channel")
    else:
        ok(f"{iface} in monitor mode on channel {chan}")

    print(f"{DIM}listening on {iface} for {args.seconds:g}s...{RST}")
    before = sniff(iface, args.seconds)
    if before is None:
        return 1

    if before > 0:
        ok(f"heard {before:,} frames -- the receive path is alive")
        note("this is not the transmit-works-receive-dead fault. If announces "
             "still are not arriving, the problem is above the radio: check "
             "the channel matches the other nodes, then beachedmesh-routes")
        return 0

    err("heard nothing at all -- the receive path is dead below beachedmesh")
    if args.check:
        skip("--check given, driver left alone")
        return 1

    # ---- reset ----
    had_service = service_installed()
    if had_service:
        run("systemctl", "stop", "beachedmesh")
        ok("service stopped")
    else:
        skip("no service installed")

    if not reload_driver():
        return 1

    if not wait_for(iface):
        err(f"{iface} did not come back within {REAPPEAR_TIMEOUT:g}s")
        unplug_advice()
        return 1
    ok(f"{iface} is back")

    if had_service:
        run("systemctl", "start", "beachedmesh")
        time.sleep(SERVICE_SETTLE)
        ok("service started")

    # ---- verify ----
    print(f"{DIM}listening on {iface} for {args.seconds:g}s...{RST}")
    after = sniff(iface, args.seconds)
    if after:
        ok(f"heard {after:,} frames -- receive path restored")
        note("confirm peers come back with: beachedmesh-routes")
        return 0

    err("still hearing nothing after the reload")
    unplug_advice()
    return 1


if __name__ == "__main__":
    sys.exit(main())
