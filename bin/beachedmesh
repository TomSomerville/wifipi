#!/usr/bin/env python3
"""The beachedmesh service.

    sudo ./bin/beachedmesh -i wlan1 --name pi4

Verifies the adapter, puts it in monitor mode, then runs continuously:
announcing on a timer, relaying what it hears, and learning routes.

One process owns the radio. The dedup cache, route table and flooder only
work if they observe all traffic, so running the announcer separately -- as
beachedmesh-announce does -- gives each half a picture.
"""

import argparse
import os
import signal
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from beachedmesh import adapter, recover                         # noqa: E402
from beachedmesh.cli import is_root, log                         # noqa: E402
from beachedmesh.control import ControlServer, DEFAULT_SOCKET    # noqa: E402
from beachedmesh.frame import DEFAULT_HOP_LIMIT                  # noqa: E402
from beachedmesh.identity import Identity                        # noqa: E402
from beachedmesh.link import MonitorLink                         # noqa: E402
from beachedmesh.node import Node                                # noqa: E402
from beachedmesh.routes import ANNOUNCE_INTERVAL, DEFAULT_DB     # noqa: E402

DEFAULT_KEY = "/var/lib/beachedmesh/node.key"


def die(msg):
    log("err", msg)
    sys.exit(1)


# ---------------------------------------------------------------- adapter --

def wait_for_iface(iface, stopping):
    """Block until the interface exists. Never give up.

    An unattended node -- a solar site that drained its battery and came back
    days later -- must recover without anyone present. Exiting because the
    adapter has not enumerated yet turns a 5 second delay into a permanently
    dead node, because systemd gives up after a few rapid failures.
    """
    if os.path.exists(f"/sys/class/net/{iface}"):
        return True
    log("warn", f"{iface} not present -- waiting for it to appear")
    waited = 0
    while not stopping:
        time.sleep(2)
        waited += 2
        if os.path.exists(f"/sys/class/net/{iface}"):
            log("ok", f"{iface} appeared after {waited}s")
            # Enumerating is not the same as ready: the driver still has
            # firmware to load before it will accept configuration.
            time.sleep(2)
            return True
        if waited % 60 == 0:
            log("warn", f"still waiting for {iface} ({waited // 60} min)")
    return False


# How many times to reload the driver for a deaf radio before giving up and
# running anyway. One reload is the documented remedy; a second covers a
# reload that raced the USB re-enumeration. Past that the fault is something
# else, and a node that keeps announcing is worth more than one that retries
# forever -- peers can still hear it, and the status line reports rx 0.
MAX_DEAF_RELOADS = 2


def radio_hears(iface):
    """True if anything at all is arriving. None if it cannot be tested."""
    heard = recover.frames_heard(iface)
    if heard is None:
        log("warn", f"cannot listen on {iface} to test the receive path")
        return None
    if heard:
        log("ok", f"receive path alive ({heard:,} frames in "
                  f"{recover.LISTEN_SECONDS:g}s)")
        return True
    return False


def recover_deaf_radio(iface, attempt):
    """Reload the driver under a radio that hears nothing. True if it is back.

    Called only after the adapter has passed every other check, which is
    exactly when this fault is invisible: monitor mode set, channel set,
    injection accepted, and not one frame arriving.
    """
    log("err", f"{iface} hears nothing at all -- receive path is dead below "
               f"beachedmesh (reload {attempt}/{MAX_DEAF_RELOADS})")
    if not recover.reload_driver(log):
        return False
    if not recover.wait_for_iface(iface):
        log("err", f"{iface} did not come back after the reload")
        return False
    log("ok", f"{iface} is back")
    return True


# ----------------------------------------------------------------- events --

def make_handlers(node, verbose):
    def on_announce(info, pkt, meta, route, verdict):
        if verdict == "own":
            return
        rssi = meta.get("rssi")
        sig = f"{rssi:>4} dBm" if rssi is not None else "   ? dBm"
        hops = max(0, node.hop_limit - pkt.hop_limit)
        who = pkt.src.hex()
        name = (info["app_data"].decode(errors="replace") if info else "") or "-"
        if route in ("new", "better", "settling"):
            log("ok", f"{route.upper():<9} {who}  {sig}  hops={hops}  "
                      f"name={name}")
        elif verbose:
            log("info", f"{route:<9} {who}  {sig}  hops={hops}")

    def on_event(kind, detail):
        if kind == "announce-sent":
            log("info", f"announced, next in "
                        f"{node.announce_interval / 60:.0f} min")
        elif kind == "announce-rejected":
            pkt, why = detail
            log("warn", f"rejected announce from {pkt.src.hex()}: {why}")
        elif kind == "expired":
            log("info", f"expired {detail.hex()} -- no announce in "
                        f"{node.routes.ttl / 86400:.0f} days")
        elif kind == "relayed" and verbose:
            log("info", f"relayed {detail.src.hex()[:8]} "
                        f"hops_left={detail.hop_limit}")

    node.on_announce = on_announce
    node.on_event = on_event


def report(node):
    s = node.status()
    log("info", f"up {s['uptime']/3600:.1f}h  "
                f"routes {s['hot_routes']:,} ({s['neighbours']} direct)  "
                f"rx {s['received']:,} tx {s['sent']:,}  "
                f"relayed {s['relayed']:,} cancelled {s['cancelled']:,}  "
                f"dup {s['duplicates']:,}")
    log("info", node.routes.summary())


def main():
    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    p.add_argument("-i", "--iface", required=True,
                   help="USB wifi adapter, e.g. wlan1")
    p.add_argument("--name", default="", help="advertise this name")
    p.add_argument("--key", default=DEFAULT_KEY)
    p.add_argument("--db", default=DEFAULT_DB)
    p.add_argument("--announce-interval", type=float,
                   default=ANNOUNCE_INTERVAL,
                   help=f"seconds (default {ANNOUNCE_INTERVAL:.0f})")
    p.add_argument("--hop-limit", type=int, default=DEFAULT_HOP_LIMIT)
    p.add_argument("--status-every", type=float, default=300.0,
                   help="seconds between status lines (0 to disable)")
    p.add_argument("-v", "--verbose", action="store_true",
                   help="log relays and refreshed routes too")
    p.add_argument("--socket", default=DEFAULT_SOCKET,
                   help=f"control socket (default {DEFAULT_SOCKET})")
    p.add_argument("--no-configure", action="store_true",
                   help="assume the interface is already in monitor mode")
    p.add_argument("--no-listen-check", action="store_true",
                   help="skip the receive-path test; never reload the driver")
    args = p.parse_args()

    if not is_root():
        die("must run as root (raw sockets, iw)")
    if not os.path.exists(args.key):
        die(f"no identity at {args.key} -- run beachedmesh-setup first")

    # Installed before any waiting, so a stop request during hardware
    # bring-up is honoured rather than ignored until the adapter appears.
    stopping = []
    for sig in (signal.SIGINT, signal.SIGTERM):
        signal.signal(sig, lambda *_: stopping.append(True))

    if not args.no_configure:
        attempt = 0
        reloads = 0
        while not stopping:
            if (wait_for_iface(args.iface, stopping)
                    and adapter.verify_and_configure(args.iface, log)):
                # Everything above says the adapter is fine. Only now is the
                # deaf-radio fault distinguishable from a healthy node, and
                # only by listening.
                if args.no_listen_check or radio_hears(args.iface) is not False:
                    break
                if reloads >= MAX_DEAF_RELOADS:
                    log("warn", "still deaf after reloading -- running anyway. "
                                "Peers will hear this node; it will hear "
                                "nobody. Unplug the adapter for ten seconds")
                    break
                reloads += 1
                recover_deaf_radio(args.iface, reloads)
                continue
            attempt += 1
            delay = min(60, 5 * attempt)
            log("warn", f"adapter not usable, retrying in {delay}s "
                        f"(attempt {attempt})")
            time.sleep(delay)
        if stopping:
            return 0

    ident = Identity.load(args.key)
    node = Node(args.iface, ident, announce_interval=args.announce_interval,
                name=args.name, db=args.db, hop_limit=args.hop_limit)
    make_handlers(node, args.verbose)

    control = ControlServer(node, args.socket)
    if control.error:
        log("warn", f"control socket unavailable: {control.error}")
    else:
        log("ok", f"control socket {args.socket}")

    warmed = node.routes.warm()
    log("ok", f"node {ident.node_id.hex()}"
              + (f" ({args.name})" if args.name else ""))
    if warmed:
        log("ok", f"warmed {warmed:,} routes from disk")
    log("ok", f"announcing every {args.announce_interval/60:.0f} min, "
              f"hop limit {args.hop_limit}")

    last_status = time.monotonic()
    while not stopping:
        try:
            node.poll()
        except OSError as e:
            # The adapter went away -- unplugged, USB reset, driver crash.
            # A remote node cannot be replugged by hand, so wait it out.
            log("err", f"radio error: {e}")
            node.link.close()
            while not stopping:
                if (wait_for_iface(args.iface, stopping)
                        and adapter.verify_and_configure(args.iface, log)):
                    try:
                        node.link = MonitorLink(args.iface)
                        log("ok", "radio recovered")
                        break
                    except OSError as e2:
                        log("err", f"reopen failed: {e2}")
                time.sleep(5)
            continue
        control.poll()
        if args.status_every and time.monotonic() - last_status >= args.status_every:
            report(node)
            last_status = time.monotonic()

    log("info", "stopping")
    report(node)
    control.close()
    node.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
